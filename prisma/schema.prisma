// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// 1. ENUM TYPES
// ==========================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  AUTHOR
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

/// Status pelatihan sesuai tampilan UI: Segera Dibuka / Dibuka / Penuh
enum PelatihanStatus {
  SEGERA_DIBUKA
  OPEN
  FULL
}

/// Level kesulitan pelatihan sesuai tampilan UI
enum LevelPelatihan {
  DASAR
  MENENGAH
  LANJUTAN
}

/// Prioritas pengumuman sesuai tampilan UI
enum PriorityLevel {
  HIGH
  NORMAL
}

enum MagangStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum FeedbackStatus {
  NEW
  READ
  PROCESSED
  ARCHIVED
}

enum KontakStatus {
  NEW
  READ
  ARCHIVED
}

enum JenisPublikasi {
  LAKIP
  LAPTAH
  ICT_INDIKATOR
  PENELITIAN
  BUKU_PUTIH
}

enum PeriodeStatistik {
  TRIWULAN_1
  TRIWULAN_2
  TRIWULAN_3
  TRIWULAN_4
  TAHUNAN
  SEMESTERAN
}

enum MediaType {
  IMAGE
  DOCUMENT
  VIDEO
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  UNPUBLISH
  ARCHIVE
  LOGIN
  LOGOUT
  UPLOAD
  DOWNLOAD
  ROLE_CHANGE
  PASSWORD_RESET
}

// ==========================================
// 2. DOMAIN: SYSTEM
// ==========================================

model User {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String     @db.VarChar(255)
  email            String     @unique @db.VarChar(255)
  passwordHash     String     @map("password_hash") @db.Text
  role             UserRole   @default(EDITOR)
  status           UserStatus @default(ACTIVE)
  avatarUrl        String?    @map("avatar_url") @db.Text
  failedLoginCount Int        @default(0) @map("failed_login_count") @db.SmallInt
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz
  lastLoginIp      String?    @map("last_login_ip") @db.VarChar(45)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  sessions           Session[]
  auditLogs          AuditLog[]
  mediaUploaded      Media[]
  settingsEdited     Settings[]          @relation("settings_updater")
  sejarahEdited      Sejarah[]           @relation("sejarah_updater")
  visiMisiEdited     VisiMisi[]          @relation("visi_misi_updater")
  beritaWritten      Berita[]            @relation("berita_author")
  pengumumanCreated  Pengumuman[]        @relation("pengumuman_creator")
  albumsCreated      GaleriAlbum[]       @relation("album_creator")
  pelatihanCreated   Pelatihan[]         @relation("pelatihan_creator")
  magangInfoEdited   MagangInfo[]        @relation("magang_info_updater")
  magangReviewed     PendaftaranMagang[] @relation("magang_reviewer")
  feedbackProcessed  Feedback[]          @relation("feedback_processor")
  publikasiCreated   Publikasi[]         @relation("publikasi_creator")
  dataKinerjaCreated DataKinerja[]       @relation("kinerja_creator")
  statPesertaCreated StatPeserta[]       @relation("stat_peserta_creator")
  infografisCreated  Infografis[]        @relation("infografis_creator")
  pesanKontakRead    PesanKontak[]       @relation("kontak_reader")

  @@index([role, status])
  @@map("users")
}

model Session {
  id        String   @id
  userId    String   @map("user_id") @db.Uuid
  expires   DateTime @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("user_sessions")
}

model AuditLog {
  id          BigInt      @id @default(autoincrement())
  userId      String?     @map("user_id") @db.Uuid
  userName    String      @map("user_name") @db.VarChar(255)
  userEmail   String      @map("user_email") @db.VarChar(255)
  action      AuditAction
  module      String      @db.VarChar(100)
  entityType  String?     @map("entity_type") @db.VarChar(100)
  entityId    String?     @map("entity_id") @db.Text
  entityTitle String?     @map("entity_title") @db.Text
  changes     Json?
  ipAddress   String?     @map("ip_address") @db.VarChar(45)
  userAgent   String?     @map("user_agent") @db.Text
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Media {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  originalName String    @map("original_name") @db.VarChar(500)
  storageKey   String    @unique @map("storage_key") @db.Text
  publicUrl    String    @map("public_url") @db.Text
  mimeType     String    @map("mime_type") @db.VarChar(100)
  fileSize     BigInt    @map("file_size")
  width        Int?
  height       Int?
  altText      String?   @map("alt_text") @db.Text
  caption      String?   @db.Text
  type         MediaType
  uploadedBy   String?   @map("uploaded_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  uploader User? @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  settingsLogo          Settings[]          @relation("site_logo")
  settingsFavicon       Settings[]          @relation("site_favicon")
  settingsOgImage       Settings[]          @relation("site_og_image")
  sejarahPhotos         SejarahPhoto[]
  jabatanPhotos         JabatanNode[]
  wilayahPhotos         WilayahKerja[]
  beritaThumbnails      Berita[]            @relation("berita_thumbnail")
  beritaOgImages        Berita[]            @relation("berita_og_image")
  pengumumanAttachments Pengumuman[]
  albumCovers           GaleriAlbum[]
  galeriPhotos          GaleriPhoto[]
  pelatihanThumbnails   Pelatihan[]         @relation("pelatihan_thumbnail")
  pelatihanBrochures    Pelatihan[]         @relation("pelatihan_brochure")
  magangCvs             PendaftaranMagang[] @relation("magang_cv")
  magangProposals       PendaftaranMagang[] @relation("magang_proposal")
  magangSuratBalasan    PendaftaranMagang[] @relation("magang_surat_balasan")
  publikasiThumbnails   Publikasi[]         @relation("publikasi_thumbnail")
  publikasiFiles        Publikasi[]         @relation("publikasi_file")
  infografisImages      Infografis[]
  stafPhotos            Staf[]
  banners               Banner[]
  aplikasiLogos         Aplikasi[]          @relation("aplikasi_logo")

  @@index([type])
  @@index([uploadedBy])
  @@index([createdAt(sort: Desc)])
  @@map("media")
}

model Settings {
  id                  Int      @id @default(1) @db.SmallInt // Singleton constraint id = 1
  siteName            String   @map("site_name") @db.VarChar(255)
  siteDescription     String?  @map("site_description") @db.Text
  siteLogoId          String?  @map("site_logo_id") @db.Uuid
  siteFaviconId       String?  @map("site_favicon_id") @db.Uuid
  contactAddress      String?  @map("contact_address") @db.Text
  contactPhone        String?  @map("contact_phone") @db.VarChar(50)
  contactEmail        String?  @map("contact_email") @db.VarChar(255)
  contactHours        String?  @map("contact_hours") @db.VarChar(255)
  contactMapsUrl      String?  @map("contact_maps_url") @db.Text
  socialInstagram     String?  @map("social_instagram") @db.VarChar(255)
  socialFacebook      String?  @map("social_facebook") @db.VarChar(255)
  socialYoutube       String?  @map("social_youtube") @db.VarChar(255)
  socialTwitter       String?  @map("social_twitter") @db.VarChar(255)
  seoOgImageId        String?  @map("seo_og_image_id") @db.Uuid
  seoMetaDescription  String?  @map("seo_meta_description") @db.Text
  announcementEnabled Boolean  @default(false) @map("announcement_enabled")
  announcementText    String?  @map("announcement_text") @db.Text
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy           String?  @map("updated_by") @db.Uuid

  siteLogo    Media? @relation("site_logo", fields: [siteLogoId], references: [id], onDelete: SetNull)
  siteFavicon Media? @relation("site_favicon", fields: [siteFaviconId], references: [id], onDelete: SetNull)
  seoOgImage  Media? @relation("site_og_image", fields: [seoOgImageId], references: [id], onDelete: SetNull)
  updater     User?  @relation("settings_updater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("settings")
}

// ==========================================
// 3. DOMAIN: PROFIL
// ==========================================

model Sejarah {
  id        Int           @id @default(1) @db.SmallInt // Singleton
  content   String        @db.Text
  status    ContentStatus @default(DRAFT)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy String?       @map("updated_by") @db.Uuid

  updater User? @relation("sejarah_updater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("sejarah")
}

model SejarahPhoto {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mediaId    String   @map("media_id") @db.Uuid
  caption    String?  @db.Text
  orderIndex Int      @default(0) @map("order_index") @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([orderIndex])
  @@map("sejarah_photos")
}

model VisiMisi {
  id        Int      @id @default(1) @db.SmallInt // Singleton
  visi      String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy String?  @map("updated_by") @db.Uuid

  updater User? @relation("visi_misi_updater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("visi_misi")
}

model MisiItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content    String   @db.Text
  orderIndex Int      @default(0) @map("order_index") @db.SmallInt
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([orderIndex])
  @@map("misi_items")
}

model UnitKerja {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(255)
  code        String?  @unique @db.VarChar(50)
  description String?  @db.Text
  orderIndex  Int      @default(0) @map("order_index") @db.SmallInt
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  staf         Staf[]
  jabatanNodes JabatanNode[]

  @@index([isActive, orderIndex])
  @@map("unit_kerja")
}

model JabatanNode {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  title       String   @db.VarChar(255)
  holderName  String?  @map("holder_name") @db.VarChar(255)
  photoId     String?  @map("photo_id") @db.Uuid
  unitKerjaId String?  @map("unit_kerja_id") @db.Uuid
  description String?  @db.Text
  level       Int      @default(0) @db.SmallInt
  orderIndex  Int      @default(0) @map("order_index") @db.SmallInt
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  parent    JabatanNode?  @relation("OrgHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  JabatanNode[] @relation("OrgHierarchy")
  photo     Media?        @relation(fields: [photoId], references: [id], onDelete: SetNull)
  unitKerja UnitKerja?    @relation(fields: [unitKerjaId], references: [id], onDelete: SetNull)
  staf      Staf[]

  @@index([parentId])
  @@index([level, orderIndex])
  @@index([unitKerjaId])
  @@map("jabatan_nodes")
}

model WilayahKerja {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provinceName String   @unique @map("province_name") @db.VarChar(255)
  officeName   String   @map("office_name") @db.VarChar(255)
  address      String?  @db.Text
  phone        String?  @db.VarChar(50)
  email        String?  @db.VarChar(255)
  websiteUrl   String?  @map("website_url") @db.Text
  photoId      String?  @map("photo_id") @db.Uuid
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  orderIndex   Int      @default(0) @map("order_index") @db.SmallInt
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  photo Media? @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@index([isActive, orderIndex])
  @@map("wilayah_kerja")
}

// ==========================================
// 4. DOMAIN: INFORMASI
// ==========================================

model KategoriBerita {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  berita Berita[]

  @@map("kategori_berita")
}

model Tag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(100)
  slug      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  beritaTags BeritaTag[]

  @@map("tags")
}

model Berita {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String        @db.VarChar(500)
  slug        String        @unique @db.VarChar(500)
  excerpt     String?       @db.Text
  content     String        @db.Text
  thumbnailId String?       @map("thumbnail_id") @db.Uuid
  ogImageId   String?       @map("og_image_id") @db.Uuid
  kategoriId  String?       @map("kategori_id") @db.Uuid
  authorId    String?       @map("author_id") @db.Uuid
  /// Nama penulis yang ditampilkan langsung di card berita (field "Oleh: ...")
  authorName  String?       @map("author_name") @db.VarChar(255)
  status      ContentStatus @default(DRAFT)
  isFeatured  Boolean       @default(false) @map("is_featured")
  viewCount   BigInt        @default(0) @map("view_count")
  publishedAt DateTime?     @map("published_at") @db.Timestamptz
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  thumbnail  Media?          @relation("berita_thumbnail", fields: [thumbnailId], references: [id], onDelete: SetNull)
  kategori   KategoriBerita? @relation(fields: [kategoriId], references: [id], onDelete: SetNull)
  author     User?           @relation("berita_author", fields: [authorId], references: [id], onDelete: SetNull)
  ogImage    Media?          @relation("berita_og_image", fields: [ogImageId], references: [id], onDelete: SetNull)
  beritaTags BeritaTag[]

  @@index([status])
  @@index([publishedAt(sort: Desc)])
  @@index([isFeatured, publishedAt(sort: Desc)])
  @@index([kategoriId, status])
  @@index([authorId])
  @@map("berita")
}

model BeritaTag {
  beritaId String @map("berita_id") @db.Uuid
  tagId    String @map("tag_id") @db.Uuid

  berita Berita @relation(fields: [beritaId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([beritaId, tagId])
  @@index([tagId])
  @@map("berita_tags")
}

model Pengumuman {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String        @db.VarChar(500)
  /// Kategori pengumuman (Sertifikasi, Rekrutmen & Magang, Layanan Publik, Pelatihan, Riset & Kebijakan)
  category     String        @db.VarChar(100)
  content      String        @db.Text
  /// Lampiran PDF yang bisa diunduh publik
  attachmentId String?       @map("attachment_id") @db.Uuid
  /// Prioritas tampilan: HIGH = label merah, NORMAL = label abu-abu
  priority     PriorityLevel @default(NORMAL)
  isPublished  Boolean       @default(false) @map("is_published")
  createdBy    String?       @map("created_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  attachment Media? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  creator    User?  @relation("pengumuman_creator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([isPublished, createdAt(sort: Desc)])
  @@index([priority])
  @@map("pengumuman")
}

