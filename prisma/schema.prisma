model GaleriPhoto {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  albumId    String   @map("album_id") @db.Uuid
  mediaId    String   @map("media_id") @db.Uuid
  caption    String?  @db.Text
