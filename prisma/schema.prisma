/// Model Banner — field sesuai HeroBanner component di halaman beranda
/// Field yang digunakan: accentBadge, title, subtitle, imageId, ctaText, ctaLink, orderIndex, isActive
model Banner {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accentBadge String   @map("accent_badge") @db.VarChar(100)
  title       String   @db.VarChar(255)
  subtitle    String   @db.Text
  imageId     String   @map("image_id") @db.Uuid
  ctaText     String   @default("Baca Selengkapnya") @map("cta_text") @db.VarChar(100)
  ctaLink     String   @default("/informasi/berita") @map("cta_link") @db.Text
  orderIndex  Int      @default(0) @map("order_index") @db.SmallInt
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  image Media @relation(fields: [imageId], references: [id], onDelete: Restrict)

  @@index([isActive, orderIndex])
  @@map("banners")
}
