model MagangInfo {
  id           Int      @id @default(1) @db.SmallInt // Singleton
  description  String   @db.Text
  requirements String?  @db.Text
  procedure    String?  @db.Text
  contactInfo  String?  @map("contact_info") @db.Text
  isOpen       Boolean  @default(false) @map("is_open")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy    String?  @map("updated_by") @db.Uuid

  updater User? @relation("magang_info_updater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("magang_info")
}

model PendaftaranMagang {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName        String       @map("full_name") @db.VarChar(255)
  email           String       @db.VarChar(255)
  phone           String       @db.VarChar(50)
  institution     String       @db.VarChar(255)
  faculty         String?      @db.VarChar(255)
  major           String?      @db.VarChar(255)
  studentId       String?      @map("student_id") @db.VarChar(100)
  periodStart     DateTime     @map("period_start") @db.Date
  periodEnd       DateTime     @map("period_end") @db.Date
  motivation      String?      @db.Text
  cvId            String?      @map("cv_id") @db.Uuid
  proposalId      String?      @map("proposal_id") @db.Uuid
  status          MagangStatus @default(PENDING)
  currentStep     Int          @default(1) @map("current_step") @db.SmallInt
  rejectionReason String?      @map("rejection_reason") @db.Text
  suratBalasanId  String?      @map("surat_balasan_id") @db.Uuid
  reviewedBy      String?      @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?    @map("reviewed_at") @db.Timestamptz
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  cv           Media? @relation("magang_cv", fields: [cvId], references: [id], onDelete: SetNull)
  proposal     Media? @relation("magang_proposal", fields: [proposalId], references: [id], onDelete: SetNull)
  suratBalasan Media? @relation("magang_surat_balasan", fields: [suratBalasanId], references: [id], onDelete: SetNull)
  reviewer     User?  @relation("magang_reviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([email])
  @@index([periodStart, periodEnd])
  @@map("pendaftaran_magang")
}

model KategoriFAQ {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @unique @db.VarChar(100)
  slug       String   @unique @db.VarChar(100)
  orderIndex Int      @default(0) @map("order_index") @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  faqs FAQ[]

  @@map("kategori_faq")
}

model FAQ {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kategoriId String?  @map("kategori_id") @db.Uuid
  question   String   @db.Text
  answer     String   @db.Text
  orderIndex Int      @default(0) @map("order_index") @db.SmallInt
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  kategori KategoriFAQ? @relation(fields: [kategoriId], references: [id], onDelete: SetNull)

  @@index([kategoriId, orderIndex])
  @@map("faq")
}

model Feedback {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String         @db.VarChar(255)
  email       String?        @db.VarChar(255)
  phone       String?        @db.VarChar(50)
  subject     String?        @db.VarChar(500)
  message     String         @db.Text
  rating      Int?           @db.SmallInt // CHECK rating BETWEEN 1 AND 5
  status      FeedbackStatus @default(NEW)
  ipAddress   String?        @map("ip_address") @db.VarChar(45)
  processedBy String?        @map("processed_by") @db.Uuid
  processedAt DateTime?      @map("processed_at") @db.Timestamptz
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz

  processor User? @relation("feedback_processor", fields: [processedBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([rating])
  @@map("feedback")
}

// ==========================================
// 6. DOMAIN: PUBLIKASI
// ==========================================

model Publikasi {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String         @db.VarChar(500)
  slug          String         @unique @db.VarChar(500)
  jenis         JenisPublikasi
  year          Int            @db.SmallInt // CHECK year BETWEEN 2000 AND 2100
  description   String?        @db.Text
  thumbnailId   String?        @map("thumbnail_id") @db.Uuid
  fileId        String         @map("file_id") @db.Uuid
  downloadCount BigInt         @default(0) @map("download_count")
  status        ContentStatus  @default(DRAFT)
  orderIndex    Int            @default(0) @map("order_index") @db.SmallInt
  createdBy     String?        @map("created_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  thumbnail Media? @relation("publikasi_thumbnail", fields: [thumbnailId], references: [id], onDelete: SetNull)
  file      Media  @relation("publikasi_file", fields: [fileId], references: [id], onDelete: Restrict)
  creator   User?  @relation("publikasi_creator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([jenis, year(sort: Desc)])
  @@index([status])
  @@map("publikasi")
}

// ==========================================
// 7. DOMAIN: STATISTIK
// ==========================================

model IndikatorKinerja {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(255)
  unit        String   @db.VarChar(50)
  description String?  @db.Text
  orderIndex  Int      @default(0) @map("order_index") @db.SmallInt
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  dataPoints DataKinerja[]

  @@map("indikator_kinerja")
}

model DataKinerja {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  indikatorId String           @map("indikator_id") @db.Uuid
  year        Int              @db.SmallInt
  period      PeriodeStatistik
  target      Decimal?         @db.Decimal(15, 2)
  realisasi   Decimal?         @db.Decimal(15, 2)
  notes       String?          @db.Text
  createdBy   String?          @map("created_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  indikator IndikatorKinerja @relation(fields: [indikatorId], references: [id], onDelete: Cascade)
  creator   User?            @relation("kinerja_creator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([indikatorId, year, period], map: "uq_data_kinerja")
  @@index([indikatorId, year(sort: Desc)])
  @@map("data_kinerja")
}

model StatPeserta {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programName  String   @map("program_name") @db.VarChar(255)
  pelatihanId  String?  @map("pelatihan_id") @db.Uuid
  year         Int      @db.SmallInt
  totalPeserta Int      @map("total_peserta")
  maleCount    Int?     @map("male_count")
  femaleCount  Int?     @map("female_count")
  notes        String?  @db.Text
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  pelatihan Pelatihan? @relation(fields: [pelatihanId], references: [id], onDelete: SetNull)
  creator   User?      @relation("stat_peserta_creator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([year(sort: Desc)])
  @@map("stat_peserta")
}

model Infografis {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String        @db.VarChar(255)
  description String?       @db.Text
  category    String?       @db.VarChar(100)
  imageId     String        @map("image_id") @db.Uuid
  orderIndex  Int           @default(0) @map("order_index") @db.SmallInt
  status      ContentStatus @default(DRAFT)
  createdBy   String?       @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  image   Media @relation(fields: [imageId], references: [id], onDelete: Restrict)
  creator User? @relation("infografis_creator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([status, orderIndex])
  @@map("infografis")
}

// ==========================================
// 8. DOMAIN: STAF
// ==========================================

model Staf {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName      String    @map("full_name") @db.VarChar(255)
  nip           String?   @unique(map: "idx_staf_nip") @db.VarChar(50)
  position      String    @db.VarChar(255)
  unitKerjaId   String?   @map("unit_kerja_id") @db.Uuid
  jabatanNodeId String?   @map("jabatan_node_id") @db.Uuid
  photoId       String?   @map("photo_id") @db.Uuid
  email         String?   @db.VarChar(255)
  phoneInternal String?   @map("phone_internal") @db.VarChar(50)
  phoneMobile   String?   @map("phone_mobile") @db.VarChar(50)
  orderIndex    Int       @default(0) @map("order_index") @db.SmallInt
  isActive      Boolean   @default(true) @map("is_active")
  joinedDate    DateTime? @map("joined_date") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  unitKerja   UnitKerja?   @relation(fields: [unitKerjaId], references: [id], onDelete: SetNull)
  jabatanNode JabatanNode? @relation(fields: [jabatanNodeId], references: [id], onDelete: SetNull)
  photo       Media?       @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@index([unitKerjaId, orderIndex])
  @@index([jabatanNodeId])
  @@index([isActive])
  @@map("staf")
}

// ==========================================
// 9. DOMAIN: KONTAK
// ==========================================

model PesanKontak {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String       @db.VarChar(255)
  email     String       @db.VarChar(255)
  phone     String?      @db.VarChar(50)
  subject   String       @db.VarChar(500)
  message   String       @db.Text
  status    KontakStatus @default(NEW)
  ipAddress String?      @map("ip_address") @db.VarChar(45)
  readBy    String?      @map("read_by") @db.Uuid
  readAt    DateTime?    @map("read_at") @db.Timestamptz
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz

  reader User? @relation("kontak_reader", fields: [readBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@map("pesan_kontak")
}

